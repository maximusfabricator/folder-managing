<?xml version="1.0" encoding="utf-8"?>
<!--
  User (release) edition manifest. Packed by scripts\release\Build-UserRelease.ps1, which overwrites Identity/@Version.
  Dev builds keep using AppxManifest.xml (FolderManagingSparseDev) so both can never be confused.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap5 uap10 rescap desktop4 desktop5 desktop6 com">

  <Identity Name="FolderManaging"
            Publisher="CN=Folder Managing"
            Version="2.0.1.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Folder Managing</DisplayName>
    <PublisherDisplayName>maximusfabricator</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Folder colors, tags and the “Folder Manager” Explorer menu.</Description>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Resources>
    <Resource Language="ru-ru" />
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="FolderManagingShell"
                 Executable="FolderManaging.Cli.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Folder Managing Shell"
        Description="Folder Managing Explorer integration"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Folder Manager Shell">
              <com:Class Id="F4B3C2B1-0A1E-4D8F-9C7B-6E5D4C3B2A01"
                         Path="FolderManaging.Shell.comhost.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="FolderManager" Clsid="F4B3C2B1-0A1E-4D8F-9C7B-6E5D4C3B2A01" />
              <!-- Keep exactly one verb: with 2+ verbs Win11 groups them under the package DisplayName. -->
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>

    <Application Id="Companion"
                 Executable="FolderManaging.Companion.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Folder Managing"
        Description="Folder colors, tags and Explorer menu settings"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <!-- Start menu shortcut and uninstall entry come from FolderManaging.Setup (one «Folder Managing» in Apps). -->
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias desktop4:Subsystem="windows">
            <uap5:ExecutionAlias Alias="foldermanaging.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
