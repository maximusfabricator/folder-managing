<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap10 rescap desktop4 desktop5 com">

  <Identity Name="FolderManagingSparseDev"
            Publisher="CN=FolderManaging Dev"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Folder Managing (Dev Package)</DisplayName>
    <PublisherDisplayName>FolderManaging</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Development MSIX for FolderManaging Explorer commands.</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    Full-trust Win32 (not AppContainer): runFullTrust + Application uap10:TrustLevel="mediumIL"
    + uap10:RuntimeBehavior="win32App" lets the COM surrogate use normal user filesystem ACLs
    without broadFileSystemAccess / Privacy toggles.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="FolderManagingSparseDevApp"
                 Executable="FolderManaging.Cli.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Folder Managing"
        Description="Folder Managing tools"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Folder Manager Shell">
              <com:Class Id="F4B3C2B1-0A1E-4D8F-9C7B-6E5D4C3B2A01"
                         Path="FolderManaging.Shell.comhost.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="FolderManager" Clsid="F4B3C2B1-0A1E-4D8F-9C7B-6E5D4C3B2A01" />
              <!-- Keep exactly one verb: with 2+ verbs Win11 groups them under the package DisplayName. -->
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
