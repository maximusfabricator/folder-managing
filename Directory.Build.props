<Project>

  <!--
    FmEdition=Dev  (default): verbose diagnostics, dev-only CLI commands.
    FmEdition=User (release / installer): error-only log, no dev tooling. Set by scripts\release\Build-UserRelease.ps1.
  -->
  <PropertyGroup>
    <FmEdition Condition="'$(FmEdition)' == ''">Dev</FmEdition>
    <Version>1.1.0</Version>
    <Product>Folder Managing</Product>
    <Company>Folder Managing</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FmEdition)' == 'Dev'">
    <DefineConstants>$(DefineConstants);FM_DEV</DefineConstants>
  </PropertyGroup>

</Project>
