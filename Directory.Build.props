<Project>

  <!--
    FmEdition=Dev  (default): verbose diagnostics, dev-only CLI commands.
    FmEdition=User (release / installer): error-only log, no dev tooling. Set by scripts\release\Build-UserRelease.ps1.
    FmUpdater=false: no update checks (for an edition that a store updates, such as the Microsoft Store).
  -->
  <PropertyGroup>
    <FmEdition Condition="'$(FmEdition)' == ''">Dev</FmEdition>
    <FmUpdater Condition="'$(FmUpdater)' == ''">true</FmUpdater>
    <Version>2.2.1</Version>
    <Product>Folder Managing</Product>
    <Company>maximusfabricator</Company>
    <Authors>maximusfabricator</Authors>
    <Copyright>Copyright (C) 2026 maximusfabricator</Copyright>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/maximusfabricator/folder-managing</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FmEdition)' == 'Dev'">
    <DefineConstants>$(DefineConstants);FM_DEV</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FmUpdater)' == 'false'">
    <DefineConstants>$(DefineConstants);FM_NO_UPDATER</DefineConstants>
  </PropertyGroup>

  <!-- User binaries must not name the machine they were built on. -->
  <PropertyGroup Condition="'$(FmEdition)' == 'User'">
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/FolderManaging/</PathMap>
  </PropertyGroup>

</Project>
