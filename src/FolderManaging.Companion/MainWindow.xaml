<ui:FluentWindow x:Class="FolderManaging.Companion.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:FolderManaging.Companion.Pages"
                 xmlns:loc="clr-namespace:FolderManaging.Companion.Localization"
                 Title="Folder Managing"
                 Icon="pack://application:,,,/Assets/FolderManaging.ico"
                 Height="720" Width="1120"
                 MinWidth="900" MinHeight="540"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Folder Managing"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNav"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           PaneDisplayMode="Left"
                           OpenPaneLength="252"
                           PaneTitle="Folder Managing">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Loc NavColors}"
                                       Icon="{ui:SymbolIcon Symbol=Color24}"
                                       TargetPageType="{x:Type pages:ColorsPage}" />
                <ui:NavigationViewItem Content="{loc:Loc NavTags}"
                                       Icon="{ui:SymbolIcon Symbol=Tag24}"
                                       TargetPageType="{x:Type pages:TagsPage}" />
                <ui:NavigationViewItem Content="{loc:Loc NavFolders}"
                                       Icon="{ui:SymbolIcon Symbol=Folder24}"
                                       TargetPageType="{x:Type pages:ManageFoldersPage}" />
                <ui:NavigationViewItem Content="{loc:Loc NavMenu}"
                                       Icon="{ui:SymbolIcon Symbol=TextBulletListLtr24}"
                                       TargetPageType="{x:Type pages:ContextMenuPage}" />
                <ui:NavigationViewItem Content="{loc:Loc NavSettings}"
                                       Icon="{ui:SymbolIcon Symbol=Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Loc NavQuickColor}"
                                       Icon="{ui:SymbolIcon Symbol=Color24}"
                                       Click="OnQuickColorClick" />
                <ui:NavigationViewItem x:Name="LogsNavItem"
                                       Content="{loc:Loc NavLogs}"
                                       Icon="{ui:SymbolIcon Symbol=DocumentText24}"
                                       Click="OnOpenLogsClick" />
                <ui:NavigationViewItem Content="{loc:Loc NavResetIcon}"
                                       Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                       Click="OnResetFolderIconClick" />
                <ui:NavigationViewItem Content="{loc:Loc NavAbout}"
                                       Icon="{ui:SymbolIcon Symbol=Info24}"
                                       TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
