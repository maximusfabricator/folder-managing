<UserControl x:Class="FolderManaging.Companion.Pages.ContextMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FolderManaging.Companion.Localization"
             Loaded="OnLoaded">
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{loc:Loc MenuPageTitle}" />
            <TextBlock Margin="0,4,0,0" Opacity="0.85" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{loc:Loc MenuPageHint}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top" FontSize="18" Symbol="Info24"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" FontSize="12" Opacity="0.95" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{loc:Loc MenuWin11Note}" />
            </Grid>
        </Border>

        <ui:CardControl Grid.Row="2" Margin="0,12,0,0" Padding="16,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{loc:Loc ItemLabel}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Loc ItemLabelHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="RootTitleBox" Width="260" PlaceholderText="Folder Manager"
                        TextChanged="OnRootTitleChanged" />
        </ui:CardControl>

        <Grid Grid.Row="3" Margin="0,12,0,0" SizeChanged="OnBodySizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PreviewGapColumn" Width="16" />
                <ColumnDefinition x:Name="PreviewColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EntriesPanel" />
            </ScrollViewer>

            <Border x:Name="PreviewCard" Grid.Column="2" Padding="14" CornerRadius="8" VerticalAlignment="Top"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <!-- The list takes the height that is left and scrolls, so the count below it stays visible. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="12" Opacity="0.85"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{loc:Loc Preview}" />
                    <TextBlock x:Name="PreviewRootTitle" Grid.Row="1" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Folder Manager  ›" />
                    <Border Grid.Row="2" Margin="0,8,0,0" Padding="6" CornerRadius="6"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PreviewPanel" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="PreviewCount" Grid.Row="3" Margin="0,8,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal">
            <ui:Button Appearance="Secondary"
                       Icon="{ui:SymbolIcon Symbol=Add24}"
                       Content="{loc:Loc AddSeparator}"
                       Click="OnAddSeparatorClick" />
            <ui:Button Margin="8,0,0,0"
                       Appearance="Caution"
                       Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                       Content="{loc:Loc ResetMenu}"
                       Click="OnResetMenuClick" />
        </StackPanel>
    </Grid>
</UserControl>
