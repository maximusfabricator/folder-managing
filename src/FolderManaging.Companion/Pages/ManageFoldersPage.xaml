<UserControl x:Class="FolderManaging.Companion.Pages.ManageFoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:pages="clr-namespace:FolderManaging.Companion.Pages">
    <UserControl.Resources>
        <Style x:Key="PathCellStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding PathDisplay}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Управление папками" />
            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="Папки с цветом, метками или закреплением в «Быстром доступе». Действия сохраняются в state.json и обновляют Проводник." />
        </StackPanel>

        <ui:Card Grid.Row="1" Padding="4">
            <Grid>
                <DataGrid x:Name="FoldersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="44"
                          Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Путь" Binding="{Binding PathDisplay}" Width="*"
                                            ElementStyle="{StaticResource PathCellStyle}" />
                        <DataGridTextColumn Header="Цвет" Binding="{Binding ColorDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="Метки" Binding="{Binding TagsDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="Закреплена" Binding="{Binding PinnedDisplay}" Width="Auto" />
                        <DataGridTemplateColumn Header="Действия" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type pages:ManagedFolderRow}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:Button Margin="0,0,6,0" Padding="10,4" Appearance="Secondary"
                                                   Icon="{ui:SymbolIcon Symbol=PinOff24}"
                                                   Content="Открепить"
                                                   Click="OnUnpinClick"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Margin="0,0,6,0" Padding="10,4" Appearance="Secondary"
                                                   Icon="{ui:SymbolIcon Symbol=TagDismiss24}"
                                                   Content="Сбросить метки"
                                                   Click="OnClearTagsClick"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Padding="10,4" Appearance="Secondary"
                                                   Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                                   Content="Сбросить цвет"
                                                   Click="OnRemoveColorClick"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyHint" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center"
                           Text="Пока нет настроенных папок. Примените цвет, метку или закрепление через контекстное меню Проводника."
                           Visibility="Collapsed" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
