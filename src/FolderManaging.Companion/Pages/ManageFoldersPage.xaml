<UserControl x:Class="FolderManaging.Companion.Pages.ManageFoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FolderManaging.Companion.Localization"
             xmlns:pages="clr-namespace:FolderManaging.Companion.Pages">
    <UserControl.Resources>
        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Paths and color ids read left to right in every language, as in Explorer. -->
        <Style x:Key="LtrCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- A narrow window wraps a long path onto a second line before trimming it. -->
        <Style x:Key="PathCellStyle" TargetType="TextBlock" BasedOn="{StaticResource LtrCellStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="40" />
        </Style>
        <!-- The text is in Tag: a list too narrow for it shows the icon alone, with the text as a tooltip. -->
        <Style x:Key="RowActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Content" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="compact">
                    <Setter Property="Content" Value="{x:Null}" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource FmText}" FontSize="28" FontWeight="SemiBold" Text="{loc:Loc FoldersTitle}" />
            <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="{loc:Loc FoldersHint}" />
        </StackPanel>

        <WrapPanel x:Name="Toolbar" Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
            <ui:Button x:Name="ResetSelectedButton" Margin="0,0,8,0" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                       Content="{loc:Loc ResetSelected}"
                       IsEnabled="False"
                       Click="OnResetSelectedClick" />
            <ui:Button x:Name="ResetAllButton" Margin="0,0,8,0" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}"
                       Content="{loc:Loc ResetAll}"
                       Click="OnResetAllClick" />
            <TextBlock x:Name="SelectionHint" Style="{StaticResource FmTextSecondary}" VerticalAlignment="Center" Opacity="0.65"
                       TextWrapping="Wrap" Text="{loc:Loc FoldersSelectHint}" />
        </WrapPanel>

        <ui:Card Grid.Row="2" Padding="4" VerticalAlignment="Top">
            <Grid>
                <DataGrid x:Name="FoldersGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          SelectionChanged="OnSelectionChanged"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="44"
                          Margin="8"
                          SizeChanged="OnGridSizeChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="PathColumn" Header="{loc:Loc ColPath}" Binding="{Binding PathDisplay}" Width="*"
                                            ElementStyle="{StaticResource PathCellStyle}" />
                        <DataGridTextColumn Header="{loc:Loc ColColor}" Binding="{Binding ColorDisplay}" Width="Auto"
                                            ElementStyle="{StaticResource LtrCellStyle}" />
                        <DataGridTextColumn Header="{loc:Loc ColTags}" Binding="{Binding TagsDisplay}" Width="Auto" MaxWidth="220"
                                            ElementStyle="{StaticResource CellStyle}" />
                        <DataGridTextColumn Header="{loc:Loc ColPinned}" Binding="{Binding PinnedDisplay}" Width="Auto"
                                            ElementStyle="{StaticResource CellStyle}" />
                        <DataGridTemplateColumn x:Name="ActionsColumn" Header="{loc:Loc ColActions}" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type pages:ManagedFolderRow}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <ui:Button Margin="0,0,6,0" Style="{StaticResource RowActionButton}"
                                                   Icon="{ui:SymbolIcon Symbol=PinOff24}"
                                                   Tag="{loc:Loc UnpinButton}"
                                                   IsEnabled="{Binding IsPinned, Mode=OneTime}"
                                                   Click="OnUnpinClick"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Margin="0,0,6,0" Style="{StaticResource RowActionButton}"
                                                   Icon="{ui:SymbolIcon Symbol=TagDismiss24}"
                                                   Tag="{loc:Loc ClearTags}"
                                                   IsEnabled="{Binding HasTags, Mode=OneTime}"
                                                   Click="OnClearTagsClick"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Style="{StaticResource RowActionButton}"
                                                   Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                                   Tag="{loc:Loc ClearColor}"
                                                   IsEnabled="{Binding HasColor, Mode=OneTime}"
                                                   Click="OnRemoveColorClick"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource FmTextSecondary}" x:Name="EmptyHint" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center"
                           Text="{loc:Loc FoldersEmpty}"
                           Visibility="Collapsed" />
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
