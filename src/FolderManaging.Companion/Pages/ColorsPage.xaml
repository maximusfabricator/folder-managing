<UserControl x:Class="FolderManaging.Companion.Pages.ColorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FolderManaging.Companion.Localization"
             xmlns:models="clr-namespace:FolderManaging.Core.Models;assembly=FolderManaging.Core"
             xmlns:conv="clr-namespace:FolderManaging.Companion.Converters"
             xmlns:pages="clr-namespace:FolderManaging.Companion.Pages"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <conv:HexRgbToBrushConverter x:Key="HexBrush" />
    </UserControl.Resources>
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource FmText}" FontSize="28" FontWeight="SemiBold" Text="{loc:Loc ColorsTitle}" />
            <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="{loc:Loc ColorsHint}" />
        </StackPanel>

        <!-- Hidden while the editor is open: in a small window the list would get no room at all. -->
        <WrapPanel x:Name="ColorsToolbar" Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal">
            <ui:Button Margin="0,0,0,8" VerticalAlignment="Center"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Add24}"
                       Content="{loc:Loc AddColor}"
                       Click="OnAddColorClick" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource FmText}" Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Text="{loc:Loc MyColorsTitle}" />
            <ItemsControl x:Name="ColorItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MenuColorPreset}">
                        <ui:CardControl Margin="0,0,0,4" Padding="16,12">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <Binding Path="HexRgb" Converter="{StaticResource HexBrush}" Mode="OneWay" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FmText}" FontSize="14"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                            <Run Text="#" /><Run Text="{Binding HexRgb, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource FmTextSecondary}" FontSize="12" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Id}"
                                                   Text="{Binding Id, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox Width="200" VerticalAlignment="Center"
                                            PlaceholderText="{loc:Loc NameOptional}"
                                            Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                            TextChanged="OnAnyTextChanged" />
                                <ui:Button Margin="8,0,0,0" VerticalAlignment="Center"
                                           Icon="{ui:SymbolIcon Symbol=Edit24}"
                                           Content="{loc:Loc Edit}"
                                           Appearance="Secondary"
                                           Click="OnEditColorClick"
                                           Tag="{Binding}" />
                                <ui:Button Margin="8,0,0,0" VerticalAlignment="Center"
                                           Icon="{ui:SymbolIcon Symbol=Delete24}"
                                           Appearance="Caution"
                                           ToolTipService.ToolTip="{loc:Loc DeleteColor}"
                                           Click="OnDeleteColorClick"
                                           Tag="{Binding}" />
                            </StackPanel>
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource FmText}" Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Text="{loc:Loc SchemesTitle}" />
            <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,8" Opacity="0.65" TextWrapping="Wrap"
                       Text="{loc:Loc SchemesHint}" />
            <ItemsControl x:Name="SchemeItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:SchemeRow}">
                        <ui:CardControl Margin="0,0,0,4" Padding="16,12">
                            <ui:CardControl.Header>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FmText}" FontSize="14" TextWrapping="Wrap"
                                               Text="{Binding Name, Mode=OneTime}" />
                                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding Swatches, Mode=OneTime}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pages:SchemeSwatch}">
                                                <Border Width="22" Height="22" Margin="0,0,4,0" CornerRadius="4"
                                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding Brush, Mode=OneTime}"
                                                        ToolTipService.ToolTip="{Binding Name, Mode=OneTime}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding IsOn, Mode=OneTime}"
                                             OffContent="{loc:Loc Off}"
                                             OnContent="{loc:Loc On}"
                                             AutomationProperties.Name="{Binding Name, Mode=OneTime}"
                                             ToolTipService.ToolTip="{loc:Loc ShowInMenu}"
                                             Tag="{Binding}"
                                             Click="OnSchemeToggleClick" />
                        </ui:CardControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ui:Card x:Name="ColorEditorCard" Grid.Row="3" Margin="0,12,0,0" Padding="20,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Превью текущего цвета -->
                <Border x:Name="EditorPreview" Grid.Column="0"
                        Width="120" Height="120" CornerRadius="10"
                        VerticalAlignment="Top"
                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                        BorderThickness="1" />

                <!-- Ползунки RGB, HEX и кнопки -->
                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource FmText}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               x:Name="ColorEditorTitle" FontSize="16" FontWeight="SemiBold" Text="{loc:Loc ColorEditor}" />

                    <TextBlock Style="{StaticResource FmTextSecondary}" Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" VerticalAlignment="Center" Opacity="0.8" Text="R" />
                    <Slider Grid.Row="1" Grid.Column="1" Margin="8,14,0,0" VerticalAlignment="Center"
                            x:Name="SliderR" Minimum="0" Maximum="255" ValueChanged="OnEditorRgbChanged" />

                    <TextBlock Style="{StaticResource FmTextSecondary}" Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Opacity="0.8" Text="G" />
                    <Slider Grid.Row="2" Grid.Column="1" Margin="8,10,0,0" VerticalAlignment="Center"
                            x:Name="SliderG" Minimum="0" Maximum="255" ValueChanged="OnEditorRgbChanged" />

                    <TextBlock Style="{StaticResource FmTextSecondary}" Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Opacity="0.8" Text="B" />
                    <Slider Grid.Row="3" Grid.Column="1" Margin="8,10,0,0" VerticalAlignment="Center"
                            x:Name="SliderB" Minimum="0" Maximum="255" ValueChanged="OnEditorRgbChanged" />

                    <TextBlock Style="{StaticResource FmTextSecondary}" Grid.Row="4" Grid.Column="0" Margin="0,14,0,0" VerticalAlignment="Center" Opacity="0.8" Text="HEX" />
                    <ui:TextBox Grid.Row="4" Grid.Column="1" Margin="8,14,0,0" MaxWidth="180" HorizontalAlignment="Left"
                                x:Name="HexEditor" MaxLength="7" PlaceholderText="RRGGBB" TextChanged="OnEditorHexChanged" />

                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Margin="0,0,8,0" Appearance="Secondary" Content="{loc:Loc Cancel}" Click="OnEditorCancel" />
                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Content="{loc:Loc Save}" Click="OnEditorApply" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <TextBlock Style="{StaticResource FmTextSecondary}" Grid.Row="4" Margin="0,12,0,0" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                   Text="{loc:Loc ColorsFooter}" />
    </Grid>
</UserControl>
