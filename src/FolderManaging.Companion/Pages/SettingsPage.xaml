<UserControl x:Class="FolderManaging.Companion.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Настройки" />
            <TextBlock Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="Параметры поведения Folder Managing в Проводнике и Companion." />

            <ui:CardControl Margin="0,20,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="Оформление" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="Светлая или тёмная тема в стиле Windows 11. «Как в системе» — следует за настройками Windows." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeCombo"
                          MinWidth="260"
                          HorizontalAlignment="Left"
                          SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Tag="System" Content="Как в системе" />
                    <ComboBoxItem Tag="Light" Content="Светлая" />
                    <ComboBoxItem Tag="Dark" Content="Тёмная" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="Права администратора для системных папок" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="Включите один раз и подтвердите окно Windows (UAC). После этого покраска и сброс на Program Files и подобных папках идут без повторных вопросов, пока служба работает." />
                        <TextBlock x:Name="WorkerStatusText" Margin="0,8,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                   Text="Статус: …" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel>
                    <ui:ToggleSwitch x:Name="AutoElevateToggle"
                                     OffContent="Выкл"
                                     OnContent="Вкл"
                                     Checked="OnAutoElevateChanged"
                                     Unchecked="OnAutoElevateChanged" />
                    <ui:Button x:Name="StartWorkerButton"
                               Margin="0,12,0,0"
                               Appearance="Secondary"
                               Content="Запустить службу администратора…"
                               Click="OnStartWorkerClick" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="Контекстное меню" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="Порядок, видимость и названия пунктов «Folder Manager» — на странице «Контекстное меню»." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Secondary"
                           Icon="{ui:SymbolIcon Symbol=Edit24}"
                           Content="Настроить меню…"
                           Click="OnOpenContextMenuPageClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="Сброс настроек" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="Возвращает контекстное меню и все параметры к стандартным. Твои цвета, метки и покрашенные папки не трогаются." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Caution"
                           Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                           Content="Сбросить настройки"
                           Click="OnResetSettingsClick" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
