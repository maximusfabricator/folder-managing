<UserControl x:Class="FolderManaging.Companion.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:FolderManaging.Companion.Localization"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,24,36,24">
            <TextBlock Style="{StaticResource FmText}" FontSize="28" FontWeight="SemiBold" Text="{loc:Loc SettingsTitle}" />
            <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="{loc:Loc SettingsHint}" />

            <ui:CardControl Margin="0,20,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FmText}" FontSize="14" FontWeight="SemiBold"
                                   Text="{loc:Loc Appearance}" />
                        <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="{loc:Loc AppearanceHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeCombo"
                          MinWidth="260"
                          HorizontalAlignment="Left"
                          SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Tag="System" Content="{loc:Loc ThemeSystem}" />
                    <ComboBoxItem Tag="Light" Content="{loc:Loc ThemeLight}" />
                    <ComboBoxItem Tag="Dark" Content="{loc:Loc ThemeDark}" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl x:Name="AutostartCard" Margin="0,12,0,0" Padding="16,14" Visibility="Collapsed">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FmText}" FontSize="14" FontWeight="SemiBold"
                                   Text="{loc:Loc Autostart}" />
                        <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="{loc:Loc AutostartHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutostartToggle"
                                 OffContent="{loc:Loc Off}"
                                 OnContent="{loc:Loc On}"
                                 Checked="OnAutostartChanged"
                                 Unchecked="OnAutostartChanged" />
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FmText}" FontSize="14" FontWeight="SemiBold"
                                   Text="{loc:Loc AdminRights}" />
                        <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="{loc:Loc AdminRightsHint}" />
                        <TextBlock Style="{StaticResource FmTextSecondary}" x:Name="WorkerStatusText" Margin="0,8,0,0" FontSize="12" Opacity="0.85" TextWrapping="Wrap"
                                   Text="{loc:Loc StatusPending}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel>
                    <ui:ToggleSwitch x:Name="AutoElevateToggle"
                                     OffContent="{loc:Loc Off}"
                                     OnContent="{loc:Loc On}"
                                     Checked="OnAutoElevateChanged"
                                     Unchecked="OnAutoElevateChanged" />
                    <ui:Button x:Name="StartWorkerButton"
                               Margin="0,12,0,0"
                               Appearance="Secondary"
                               Content="{loc:Loc StartAdminService}"
                               Click="OnStartWorkerClick" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FmText}" FontSize="14" FontWeight="SemiBold"
                                   Text="{loc:Loc ContextMenuCard}" />
                        <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="{loc:Loc ContextMenuCardHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Secondary"
                           Icon="{ui:SymbolIcon Symbol=Edit24}"
                           Content="{loc:Loc ConfigureMenu}"
                           Click="OnOpenContextMenuPageClick" />
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0" Padding="16,14">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FmText}" FontSize="14" FontWeight="SemiBold"
                                   Text="{loc:Loc ResetSettingsCard}" />
                        <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,4,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="{loc:Loc ResetSettingsHint}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Appearance="Caution"
                           Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                           Content="{loc:Loc ResetSettings}"
                           Click="OnResetSettingsClick" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
