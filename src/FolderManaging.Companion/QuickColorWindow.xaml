<ui:FluentWindow x:Class="FolderManaging.Companion.QuickColorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:FolderManaging.Companion.Localization"
                 xmlns:controls="clr-namespace:FolderManaging.Companion.Controls"
                 Title="{loc:Loc QuickTitle}"
                 Icon="pack://application:,,,/Assets/FolderManaging.ico"
                 Width="420" Height="560"
                 MinWidth="380" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Loc QuickTitle}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock Style="{StaticResource FmTextSecondary}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{loc:Loc QuickHint}" />

            <Grid Height="240" Margin="0,0,0,8">
                <controls:ColorWheelControl x:Name="Wheel"
                                            Width="240" Height="240"
                                            HorizontalAlignment="Center"
                                            ColorChanged="OnWheelColorChanged" />
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewSwatch" Grid.Column="0"
                        Width="36" Height="36" CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <Slider Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                        x:Name="BrightnessSlider" Minimum="5" Maximum="100" Value="100"
                        ValueChanged="OnBrightnessChanged" />
                <TextBlock Style="{StaticResource FmText}" Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14"
                           x:Name="HexText" Text="007ACC" />
            </Grid>

            <TextBlock Style="{StaticResource FmTextSecondary}" Margin="0,16,0,4" FontSize="12" Opacity="0.65" Text="{loc:Loc Folder}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FmTextSecondary}" x:Name="FolderPathText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{loc:Loc FolderNotSelected}" Opacity="0.9" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0"
                           Appearance="Secondary"
                           Content="{loc:Loc Browse}"
                           Click="OnPickFolderClick" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <ui:Button Margin="0,0,8,0" Appearance="Secondary" Content="{loc:Loc Cancel}" Click="OnCancelClick" />
            <ui:Button x:Name="ApplyButton"
                       Appearance="Primary"
                       Icon="{ui:SymbolIcon Symbol=Color24}"
                       Content="{loc:Loc Paint}"
                       Click="OnApplyClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
