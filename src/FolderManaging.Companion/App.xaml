<Application x:Class="FolderManaging.Companion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
              Do not set an implicit TextBlock style: it overrides Primary/Caution button labels.
              Pages bind label Foreground to these theme brushes (same as ContextMenuPage).
            -->
            <Style x:Key="FmText" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="FmTextSecondary" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Fallbacks; AppThemeService replaces these with shades of the Windows accent. -->
            <SolidColorBrush x:Key="FmCautionBackground" Color="#F7630C" />
            <SolidColorBrush x:Key="FmCautionBackgroundPointerOver" Color="#E6F7630C" />
            <SolidColorBrush x:Key="FmCautionBackgroundPressed" Color="#CCF7630C" />
            <SolidColorBrush x:Key="FmCautionForeground" Color="#000000" />
            <SolidColorBrush x:Key="FmCautionForegroundPressed" Color="#CC000000" />

            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Caution">
                        <Setter Property="Background" Value="{DynamicResource FmCautionBackground}" />
                        <Setter Property="MouseOverBackground" Value="{DynamicResource FmCautionBackgroundPointerOver}" />
                        <Setter Property="PressedBackground" Value="{DynamicResource FmCautionBackgroundPressed}" />
                        <Setter Property="Foreground" Value="{DynamicResource FmCautionForeground}" />
                        <Setter Property="PressedForeground" Value="{DynamicResource FmCautionForegroundPressed}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
