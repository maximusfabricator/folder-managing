<ui:FluentWindow x:Class="FolderManaging.Companion.FmMessageBox"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Icon="pack://application:,,,/Assets/FolderManaging.ico"
                 Width="480" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="24,4,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="Glyph" Grid.Column="0" FontSize="28" Margin="0,0,16,0"
                           VerticalAlignment="Top" Visibility="Collapsed" />
            <ScrollViewer Grid.Column="1" MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Body" Style="{StaticResource FmText}" FontSize="14" TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="24,16"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</ui:FluentWindow>
